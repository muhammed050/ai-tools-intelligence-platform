# PUBLIC — safe to expose to the browser. Use the production domain after deployment.
NEXT_PUBLIC_SITE_URL=https://eldevo.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# SERVER ONLY — never use a NEXT_PUBLIC_ prefix and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI provider configuration — server only. At least one compatible provider is optional;
# the Finder keeps its deterministic fallback when no provider is configured.
AI_PROVIDER_API_KEY=your_ai_provider_api_key
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Configure Google OAuth in Supabase Dashboard > Authentication > Providers, not in this file.
# Google Authorized redirect URI: https://<project-ref>.supabase.co/auth/v1/callback
# Supabase redirect allow-list: https://eldevo.com/auth/callback and http://localhost:3000/auth/callback
